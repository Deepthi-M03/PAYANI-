# PAYANI environment. Copy to .env (or run `python scripts/gen_secrets.py`, which
# copies this file and fills every CHANGE_ME with a random value). Never commit .env.

ENVIRONMENT=development
LOG_LEVEL=INFO

# Database (docker compose overrides DATABASE_URL to point at the `db` service)
POSTGRES_PASSWORD=payani
DATABASE_URL=postgresql+psycopg://payani:payani@localhost:5432/payani
TEST_DATABASE_URL=postgresql+psycopg://payani:payani@localhost:5432/payani_test

# Auth — JWT_SECRET must be at least 32 random characters
JWT_SECRET=CHANGE_ME
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=14
COOKIE_SECURE=false
# JSON list of allowed browser origins (no wildcard)
CORS_ORIGINS=["http://localhost:5173"]

# Development seed accounts (passenger@ / admin@ / superadmin@example.com)
SEED_PASSENGER_PASSWORD=CHANGE_ME
SEED_ADMIN_PASSWORD=CHANGE_ME
SEED_SUPER_ADMIN_PASSWORD=CHANGE_ME

# Optional channels (leave empty to keep them off; nothing paid is needed)
SMTP_HOST=
SMTP_PORT=1025
SMTP_FROM=PAYANI <no-reply@example.com>
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Worker: separate process locally; set true to run it inside the API (free hosting)
RUN_WORKER_IN_API=false
# Shared secret for POST /api/v1/internal/tick (external wake-up); generated in production
WORKER_TICK_TOKEN=CHANGE_ME

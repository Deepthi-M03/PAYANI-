# Frontend build-time settings (optional). Copy to .env.local to override.
# Map style for MapLibre. Default: OpenFreeMap "positron" (free, no key).
# VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron

# Optional Google Maps (OFF by default; needs a Google Cloud billing account and the owner's approval).
# "Open in Google Maps" links work without any of this. See docs/timetable-data.md.
# VITE_MAP_PROVIDER=maplibre
# VITE_GOOGLE_MAPS_API_KEY=
